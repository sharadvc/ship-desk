{
	"$schema": "https://raw.githubusercontent.com/nicegui/nicegui/refs/heads/main/nicegui/static/tauri_v2_schema.json",
	"productName": "Ship Desk",
	"identifier": "com.shipdesk.app",
	"version": "0.1.0",
	"build": {
		"beforeDevCommand": "npx vite --port 1420",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build:frontend",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"macOSPrivateApi": true,
		"windows": [
			{
				"title": "Ship Desk",
				"width": 1180,
				"height": 780,
				"minWidth": 720,
				"minHeight": 480,
				"decorations": false,
				"transparent": true,
				"shadow": true,
				"backgroundColor": "#00000000",
				"center": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
		}
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"appimage": {
				"files": {
					"usr/share/metainfo/com.shipdesk.app.metainfo.xml": "linux/com.shipdesk.app.metainfo.xml"
				}
			},
			"deb": {
				"files": {
					"usr/share/metainfo/com.shipdesk.app.metainfo.xml": "linux/com.shipdesk.app.metainfo.xml"
				}
			},
			"rpm": {
				"files": {
					"usr/share/metainfo/com.shipdesk.app.metainfo.xml": "linux/com.shipdesk.app.metainfo.xml"
				}
			}
		}
	},
	"plugins": {
		"shell": {
			"open": "^https?://"
		}
	}
}
